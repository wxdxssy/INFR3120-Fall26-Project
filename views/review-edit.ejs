<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit Review | Campus Bites</title>
  <link rel="stylesheet" href="/Content/app.css">
</head>
<body>
  <main>
    <h1>Edit Review</h1>
    <% if (error) { %><p role="alert"><%= error %></p><% } %>
    <form action="/reviews/<%= review._id %>/edit" method="post">
      <p><label for="restaurant">Restaurant name</label>
      <input type="text" id="restaurant" name="restaurant" value="<%= review.restaurant %>" required></p>
      <p><label for="dish">Dish</label>
      <input type="text" id="dish" name="dish" value="<%= review.dish %>" required></p>
      <p><label for="price">Price paid (CAD)</label>
      <input type="number" min="0" step="0.01" id="price" name="price" value="<%= review.price %>" required></p>
      <p><label for="rating">Rating out of 5</label>
      <select id="rating" name="rating" required>
        <% for (let rating = 1; rating <= 5; rating++) { %>
          <option value="<%= rating %>" <%= Number(review.rating) === rating ? 'selected' : '' %>><%= rating %></option>
        <% } %>
      </select></p>
      <p><label for="comment">Write your thoughts</label>
      <textarea id="comment" name="comment" required><%= review.comment %></textarea></p>
      <button type="submit">Save Changes</button>
      <a href="/">Cancel</a>
    </form>
  </main>
</body>
</html>
